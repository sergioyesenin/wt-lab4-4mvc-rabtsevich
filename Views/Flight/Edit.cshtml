@model wt_lab4_4mvc_rabtsevich.Models.Flight
@{ ViewData["Title"] = "Редактирование рейса"; }

<div class="container py-4">
    <div class="card shadow-sm rounded-4 border-0 mx-auto" style="max-width: 720px;">
        <div class="card-body p-4">
            <h2 class="mb-4 fw-bold">✏️ Редактирование рейса #@Model.Id</h2>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FlightNumber" class="form-label"></label>
                        <input asp-for="FlightNumber" class="form-control" />
                        <span asp-validation-for="FlightNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartureTime" class="form-label"></label>
                        <input asp-for="DepartureTime" type="datetime-local" class="form-control"
                               value="@Model.DepartureTime.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Departure" class="form-label"></label>
                        <input asp-for="Departure" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Destination" class="form-label"></label>
                        <input asp-for="Destination" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TicketPrice" class="form-label"></label>
                        <input asp-for="TicketPrice" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SeatsAvailable" class="form-label"></label>
                        <input asp-for="SeatsAvailable" type="number" class="form-control" />
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">Сохранить изменения</button>
                    <a asp-action="Index" class="btn btn-secondary">← Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
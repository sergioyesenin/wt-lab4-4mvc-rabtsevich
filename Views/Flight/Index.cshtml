@model List<wt_lab4_4mvc_rabtsevich.Models.Flight>
@{
    ViewData["Title"] = "Рейсы";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">✈️ Каталог рейсов</h1>
            <p class="text-muted mb-0">Система управления авиарейсами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-3">
            + Добавить рейс
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Поиск по пункту назначения…" />
                <button class="btn btn-outline-primary">Найти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
            </form>
        </div>
        <div class="col-md-6 text-md-end">
            <span class="badge bg-success fs-6 p-3 rounded-3">
                Активных рейсов: @Model.Count(f => f.IsActive)
            </span>
            <span class="badge bg-info text-dark fs-6 p-3 rounded-3">
                Общая стоимость активных: @ViewBag.TotalActivePrice ₽
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning rounded-4">Рейсы не найдены.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var f in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 border-0 flight-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-secondary rounded-pill">ID: @f.Id</span>
                                <span class="badge rounded-pill @(f.IsActive ? "bg-success" : "bg-danger")">
                                    @(f.IsActive ? "Активен" : "Неактивен")
                                </span>
                            </div>
                            <h5 class="card-title fw-bold mb-1">@f.FlightNumber</h5>
                            <p class="text-muted mb-2">
                                @f.Departure <i class="bi bi-arrow-right"></i> @f.Destination
                            </p>
                            <p class="mb-2"><small>🕓 @f.DepartureTime.ToString("dd.MM.yyyy HH:mm")</small></p>
                            <p class="mb-2">Мест: <span class="badge bg-light text-dark">@f.SeatsAvailable</span></p>
                            <p class="fs-4 fw-bold text-primary mb-3">@f.TicketPrice ₽</p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@f.Id"
                                   class="btn btn-sm btn-outline-primary flex-fill">Подробнее</a>
                                <a asp-action="Edit" asp-route-id="@f.Id"
                                   class="btn btn-sm btn-outline-warning flex-fill">Изменить</a>
                                <form asp-action="Delete" asp-route-id="@f.Id" method="post"
                                      onsubmit="return confirm('Удалить рейс?');" class="flex-fill">
                                    <button class="btn btn-sm btn-outline-danger w-100">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .flight-card { transition: transform .15s ease, box-shadow .15s ease; }
    .flight-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15); }
</style>